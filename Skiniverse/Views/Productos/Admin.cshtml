@model IEnumerable<Skiniverse.Models.Producto>

@{
    ViewData["Title"] = "Administrar Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Panel de Administración de Productos</h2>
        <a asp-action="Crear" class="btn btn-skin-primary">
            <i class="bi bi-plus-lg me-1"></i> Agregar Nuevo Producto
        </a>
    </div>

    <div class="card card-skin shadow-sm p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Imagen</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Tipo de Piel</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-center" style="width: 170px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl" alt="@item.NombreProducto" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Sin imagen</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.NombreProducto</td>
                                <td>@item.Categoria</td>
                                <td>@item.TipoPielRecomendado</td>
                                <td>$@item.PrecioRegular.ToString("N2")</td>
                                <td>
                                    <span class="badge @(item.StockActual > 5 ? "bg-success" : "bg-warning text-dark")">
                                        @item.StockActual unidades
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil-fill"></i> Editar
                                        </a>
                                        <a asp-action="Detalles" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-danger" title="Borrar" onclick="return confirm('¿Seguro que deseas eliminar este producto?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron productos registrados en la base de datos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>