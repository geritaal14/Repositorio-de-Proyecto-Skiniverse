    <!-- Puntos de navegación para categorías -->
    <div class="carousel-indicators categories-indicators position-relative mt-4">
        <button type="button" data-bs-target="#categoriesCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Página 1"></button>
