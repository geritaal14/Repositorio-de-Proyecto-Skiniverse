<!-- 3. Sección ¿Cuál es tu tipo de piel? -->
<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase" style="color: #1B3C73;">¿CUÁL ES TU TIPO DE PIEL?</h2>
        <p class="text-muted">¿Sabías que cada tipo de piel necesita un cuidado único? Descubre los consejos y productos que tu piel necesita:</p>
    </div>

    <div class="row g-4">
        <!-- Arrugas -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="arrugas" class="skin-type-card bg-skin-arrugas">
                <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=300&q=80" alt="Piel Con Arrugas" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Con Arrugas</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>

        <!-- Piel Grasa -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="grasa" class="skin-type-card bg-skin-grasa">
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=300&q=80" alt="Piel Grasa" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Grasa</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>

        <!-- Piel Mixta -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="mixta" class="skin-type-card bg-skin-mixta">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80" alt="Piel Mixta" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Mixta</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>

        <!-- Piel Normal -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="normal" class="skin-type-card bg-skin-normal">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=300&q=80" alt="Piel Normal" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Normal</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>

        <!-- Piel Seca -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="seca" class="skin-type-card bg-skin-seca">
                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=300&q=80" alt="Piel Seca" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Seca</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>

        <!-- Manchas -->
        <div class="col-12 col-md-6">
            <a asp-controller="Consejos" asp-action="Detalle" asp-route-tipo="manchas" class="skin-type-card bg-skin-manchas">
                <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=300&q=80" alt="Piel Con Manchas" class="skin-type-img" />
                <span class="skin-type-title flex-grow-1">Piel Con Manchas</span>
                <span class="text-primary fw-bold small text-nowrap">Leer más <i class="bi bi-chevron-right ms-1"></i></span>
            </a>
        </div>
    </div>
</div>

<!-- Script de ejecución automática ininterrumpida -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Inicialización Banner Principal
            var heroElement = document.querySelector('#heroCarousel');
            if (heroElement) {
                var heroCarousel = new bootstrap.Carousel(heroElement, {
                    interval: 3000,
                    ride: 'carousel',
                    pause: false
                });
                heroCarousel.cycle();
            }

            // Inicialización Carrusel de Categorías
            var categoriesElement = document.querySelector('#categoriesCarousel');
            if (categoriesElement) {
                var categoriesCarousel = new bootstrap.Carousel(categoriesElement, {
                    interval: 3500,
                    ride: 'carousel',
                    pause: false
                });
                categoriesCarousel.cycle();
            }
        });
    </script>
}