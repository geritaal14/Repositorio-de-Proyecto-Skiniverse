@{
    ViewData["Title"] = "Inicio - Skiniverse";
}

<style>
    /* Rompe el contenedor global para ocupar todo el ancho visible */
    .full-width-carousel-wrapper {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding-left: 2rem;
        padding-right: 2rem;
    }

    .hero-carousel-container {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(27, 60, 115, 0.08);
        background-color: #ffffff;
        width: 100%;
    }

    /* Diapositiva 1 - Mayor altura (520px) */
    .hero-banner-slide-1 {
        background: linear-gradient(135deg, #EBF4F6 0%, #D4EBF2 100%);
        padding: 80px 80px;
        min-height: 520px;
        display: flex;
        align-items: center;
    }

    /* Diapositiva 2 - Mayor altura (520px) */
    .hero-banner-slide-2 {
        background: linear-gradient(135deg, #DCEEF3 0%, #C3E3EC 100%);
        padding: 80px 80px;
        min-height: 520px;
        display: flex;
        align-items: center;
    }

    .badge-blue {
        background-color: #ffffff;
        color: #028090;
        font-weight: 700;
        border-radius: 50px;
        padding: 8px 18px;
        font-size: 0.85rem;
        display: inline-block;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .btn-skin-blue {
        background-color: #1B3C73;
        color: #ffffff;
        border: none;
        border-radius: 50px;
        padding: 14px 36px;
        font-weight: 700;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(27, 60, 115, 0.25);
    }

        .btn-skin-blue:hover {
            background-color: #028090;
            color: #ffffff;
            transform: translateY(-2px);
        }

    /* Tarjetas de Categorías */
    .category-card {
        border-radius: 16px;
        padding: 24px 15px 20px 15px;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none !important;
        color: #0D1B2A;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        height: 100%;
        border: 1px solid rgba(2, 128, 144, 0.08);
    }

        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(27, 60, 115, 0.12);
            color: #1B3C73;
        }

    .category-img-wrapper {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        width: 100%;
    }

        .category-img-wrapper img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
            filter: drop-shadow(0px 8px 12px rgba(0,0,0,0.08));
        }

    .btn-cat-action {
        background-color: #1B3C73;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 50px;
        padding: 8px 20px;
        transition: all 0.3s ease;
        margin-top: 15px;
        border: none;
    }

    .category-card:hover .btn-cat-action {
        background-color: #028090;
        color: #ffffff;
    }

    /* Colores de fondo para tarjetas */
    .bg-cat-azul-1 {
        background-color: #EBF4F6;
    }

    .bg-cat-azul-2 {
        background-color: #E1F1F5;
    }

    .bg-cat-azul-3 {
        background-color: #D6EDF3;
    }

    .bg-cat-azul-4 {
        background-color: #CCE8F0;
    }

    .bg-cat-azul-5 {
        background-color: #C3E3EC;
    }

    /* Indicadores personalizados para el carrusel de categorías */
    .categories-indicators [data-bs-target] {
        background-color: #1B3C73;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 4px;
    }

    /* Estilos corregidos para la sección Tipo de Piel */
    .skin-type-card {
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center;
        text-decoration: none !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        min-height: 120px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        padding-right: 15px;
    }

        .skin-type-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(27, 60, 115, 0.12);
        }

    .skin-type-img {
        width: 130px;
        min-width: 130px;
        height: 120px;
        object-fit: cover;
    }

    .skin-type-title {
        font-weight: 700;
        font-size: 1.15rem;
        color: #1B3C73;
        padding: 0 15px;
        line-height: 1.2;
    }

    .bg-skin-arrugas {
        background-color: #D6E4F0;
    }

    .bg-skin-grasa {
        background-color: #EBF4F6;
    }

    .bg-skin-mixta {
        background-color: #E1F5FE;
    }

    .bg-skin-normal {
        background-color: #FCE4EC;
    }

    .bg-skin-seca {
        background-color: #FFF8E1;
    }

    .bg-skin-manchas {
        background-color: #E8F5E9;
    }
</style>

<!-- Banner Superior Amplio -->
<div class="full-width-carousel-wrapper">
    <div id="heroCarousel" class="carousel slide hero-carousel-container mb-5" data-bs-ride="carousel" data-bs-pause="false" data-bs-interval="3000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        </div>

        <div class="carousel-inner">
            <!-- Diapositiva 1 -->
            <div class="carousel-item active">
                <div class="hero-banner-slide-1">
                    <div class="row align-items-center w-100">
                        <div class="col-lg-7 ps-lg-4">
                            <span class="badge-blue mb-3">
                                ✨ Experiencias Skiniverse
                            </span>
                            <h1 class="display-3 fw-bold mb-3" style="color: #1B3C73;">
                                Tu piel, tu propio universo
                            </h1>
                            <p class="text-secondary fs-4 mb-4">
                                Explora productos formulados para devolver el balance, la luz y la textura natural de tu rostro. Una experiencia de skincare hecha a tu medida.
                            </p>
                            <a asp-controller="Quiz" asp-action="Index" class="btn btn-skin-blue fs-5">
                                Encuentra tu rutina ideal ✨ <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                        <div class="col-lg-5 text-center mt-4 mt-lg-0">
                            <img src="https://static.vecteezy.com/system/resources/previews/057/639/867/large_2x/a-man-and-woman-are-smiling-while-using-facial-products-couple-skincare-routine-photo.jpeg"
                                 class="img-fluid rounded-4 shadow"
                                 alt="Beauty Date Skiniverse"
                                 style="max-height: 400px; width: 100%; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Diapositiva 2 -->
            <div class="carousel-item">
                <div class="hero-banner-slide-2">
                    <div class="row align-items-center w-100">
                        <div class="col-lg-7 ps-lg-4">
                            <span class="badge-blue mb-3">
                                🌿 Novedad de Temporada
                            </span>
                            <h1 class="display-3 fw-bold mb-3" style="color: #1B3C73;">
                                Piel Radiante & <span style="color: #028090;">Saludable</span>
                            </h1>
                            <p class="text-secondary fs-4 mb-4">
                                Descubre nuestra selección exclusiva de tónicos, esencias y sérums de alta calidad.
                            </p>
                            <a asp-controller="Productos" asp-action="Catalogo" class="btn btn-skin-blue fs-5">
                                Explorar Catálogo <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                        <div class="col-lg-5 text-center mt-4 mt-lg-0">
                            <img src="https://thumbs.dreamstime.com/b/cosm%C3%A9ticos-antienvejecedores-de-los-pares-de-los-pares-9495551.jpg"
                                 class="img-fluid rounded-4 shadow"
                                 alt="Skincare Skiniverse"
                                 style="max-height: 400px; width: 100%; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Controles Banner -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>

<!-- 2. Sección de Categorías -->
<div class="text-center mb-4">
    <h3 class="fw-bold" style="color: #1B3C73;">Encuentra por Categoría</h3>
    <p class="text-muted">Explora nuestros productos según las necesidades reales de tu piel</p>
</div>

<!-- Carrusel de Categorías Automático -->
