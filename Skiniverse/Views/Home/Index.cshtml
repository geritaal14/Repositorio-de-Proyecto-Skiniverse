                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bloque 2: Siguiente grupo de categorías -->
        <div class="carousel-item">
            <div class="row g-4 justify-content-center">
                <!-- Protectores Labiales -->
                <div class="col-12 col-sm-6 col-md-4 col-lg">
                    <div class="category-card bg-cat-azul-1">
                        <div class="category-img-wrapper">
                            <img src="https://i5.walmartimages.com/asr/29fff3c5-c37b-40c2-b394-7f6ee0083a53_1.d9a07f7b30c0ad1717f9c081f6c2af32.jpeg?odnHeight=612&odnWidth=612&odnBg=FFFFFF" alt="Protectores Labiales" />
