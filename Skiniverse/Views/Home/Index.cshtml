                        <a asp-controller="Productos" asp-action="Catalogo" asp-route-categoria="Limpiadores" class="btn btn-cat-action">
                            Ver catálogo &rarr;
                        </a>
                    </div>
                </div>

                <!-- Tonicos -->
                <div class="col-12 col-sm-6 col-md-4 col-lg">
                    <div class="category-card bg-cat-azul-2">
                        <div class="category-img-wrapper">
                            <img src="https://miriam.mx/assets/img/_blogTall/7550/Mujer-aplica%CC%81ndose-to%CC%81nico-facial.webp" alt="Tónicos" />
                        </div>
                        <h6 class="fw-bold mb-0" style="color: #1B3C73;">Tónicos</h6>
                        <a asp-controller="Productos" asp-action="Catalogo" asp-route-categoria="Tónicos" class="btn btn-cat-action">
                            Ver catálogo &rarr;
                        </a>
                    </div>
                </div>

                <!-- Esencias -->
                <div class="col-12 col-sm-6 col-md-4 col-lg">
                    <div class="category-card bg-cat-azul-3">
                        <div class="category-img-wrapper">
                            <img src="https://thumbs.dreamstime.com/b/joven-y-hermosa-mujer-aplicando-s%C3%A9rum-facial-452274362.jpg" alt="Esencias" />
                        </div>
                        <h6 class="fw-bold mb-0" style="color: #1B3C73;">Esencias</h6>
                        <a asp-controller="Productos" asp-action="Catalogo" asp-route-categoria="Esencias" class="btn btn-cat-action">
                            Ver catálogo &rarr;
                        </a>
                    </div>
                </div>

                <!-- Serums -->
                <div class="col-12 col-sm-6 col-md-4 col-lg">
                    <div class="category-card bg-cat-azul-4">
                        <div class="category-img-wrapper">
                            <img src="https://blog.weareprovital.com/wp-content/uploads/2024/10/serum-para-hombres.jpg" alt="Sérums" />
                        </div>
                        <h6 class="fw-bold mb-0" style="color: #1B3C73;">Sérums</h6>
                        <a asp-controller="Productos" asp-action="Catalogo" asp-route-categoria="Sérums" class="btn btn-cat-action">
                            Ver catálogo &rarr;
                        </a>
                    </div>
                </div>

                <!-- Kits Bioaqua -->
                <div class="col-12 col-sm-6 col-md-4 col-lg">
                    <div class="category-card bg-cat-azul-5">
                        <div class="category-img-wrapper">
                            <img src="https://exitocol.vtexassets.com/arquivos/ids/24962836/rutina-hidratante-de-acido-hialuronico-y-extracto-de-rosas-bioaqua.jpg?v=638635699180000000" alt="Kits Bioaqua" />
                        </div>
                        <h6 class="fw-bold mb-0" style="color: #1B3C73;">Kits Bioaqua</h6>
                        <a asp-controller="Productos" asp-action="Catalogo" asp-route-categoria="Kits Bioaqua" class="btn btn-cat-action">
